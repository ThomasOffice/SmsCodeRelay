# ===== 验证码蓝牙中继 - PC 端配置 =====

# 预共享 token，必须与 Android App 中填写的一致（防伪）
# 运行 exe 后可在主窗口点击"生成新 Token"自动生成
token: "CHANGE_ME"

# 去重窗口（秒）：相同验证码在此时间内只处理一次
dedup_seconds: 3

# 验证码识别规则（正则，按顺序匹配，命中即止）
code_rules:
  # 关键词 + 附近 4-8 位数字
  - name: "中文验证码"
    pattern: '(?:验证码|动态码|校验码|认证码|验证|密码)[^\d]{0,20}(\d{4,8})'
  - name: "英文验证码"
    pattern: '(?:verification code|code|OTP|passcode)[^\d]{0,20}(\d{4,8})'
    flags: "IGNORECASE"
  # 兜底：单独的 4-8 位数字
  - name: "纯数字兜底"
    pattern: '\b(\d{4,8})\b'

# 通知开关
notify: true

# ===== 邮箱验证码接收（IMAP 轮询）=====
# 在程序主窗口点击"邮箱设置"即可配置并自动保存到此处。
# QQ 邮箱需先在网页端开启 IMAP 并生成授权码（设置 → 账号 → 开启 IMAP/SMTP 服务）。
email:
  enabled: false
  imap_host: "imap.qq.com"
  imap_port: 993
  username: ""
  password: ""            # QQ 授权码（非登录密码）
  poll_interval: 30       # 轮询间隔（秒）
  since_days: 1           # 只处理最近 N 天的邮件
  mark_seen: true         # 处理后是否标记为已读
  strict: true            # 严格模式：只处理含"验证码"等关键词的邮件，避免营销邮件误提取

# 日志级别：DEBUG / INFO / WARNING / ERROR
log_level: "INFO"
